# ZAZU keeper service for the pons v1 WETH/ZAZU V3 flow
# Replace every angle-bracket placeholder before importing into Railway.
# Railway service settings (not environment variables): one replica, restart
# policy Never, GitHub autodeploy disabled, and no overlapping deployments.
# Before every start or resume, stop the service and verify the signer wallet's
# latest nonce equals its pending nonce. The keeper repeats that check at live
# startup and immediately before every write, then submits that nonce explicitly.
# The keeper polls once per minute, while the collector and vault independently
# enforce their 15-minute claim and buyback intervals.

ROBINHOOD_RPC_URL=https://<ROBINHOOD_CHAIN_RPC_HOST>
CHAIN_ID=4663
BUYBACK_VAULT_ADDRESS=<BUYBACK_VAULT_ADDRESS>
PONS_FEE_COLLECTOR_ADDRESS=<PREDEPLOYED_PONS_FEE_COLLECTOR_ADDRESS>
PONS_LOCKER_ADDRESS=0x736D76699C26D0d966744cAe304C000d471f7F35

# Secret signer. Never expose this to Vercel or a browser variable.
KEEPER_PRIVATE_KEY=<0x_64_HEX_CHARACTER_PRIVATE_KEY>
# Public address is required for dry runs. Dry-run mode ignores the private key.
KEEPER_ADDRESS=<KEEPER_PUBLIC_ADDRESS>

# Fail-closed copies of the deployed vault configuration
ZAZU_TOKEN_ADDRESS=<ZAZU_TOKEN_ADDRESS>
DEX_ROUTER_ADDRESS=<DEPLOYED_PONS_V3_ADAPTER_ADDRESS>
WRAPPED_NATIVE_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
BUYBACK_DESTINATION=0x000000000000000000000000000000000000dEaD
FEE_TOKEN_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
MIN_EXECUTION_AMOUNT=<MINIMUM_AMOUNT_IN_BASE_UNITS>
MAX_EXECUTION_AMOUNT=<MAXIMUM_AMOUNT_IN_BASE_UNITS>
MAX_SLIPPAGE_BPS=<INTEGER_FROM_1_TO_500>

# Trusted quote service for the exact deployed pons adapter
KEEPER_QUOTE_API_URL=https://<SITE_HOST>/api/quote
KEEPER_QUOTE_API_KEY=<SAME_SHARED_KEEPER_QUOTE_SECRET_AS_VERCEL>
KEEPER_MAX_PRICE_IMPACT_BPS=<MAXIMUM_PRICE_IMPACT_BPS>
KEEPER_MAX_GAS_UNITS=<MAXIMUM_GAS_UNITS>
KEEPER_MAX_GAS_COST_WEI=<MAXIMUM_TOTAL_GAS_COST_IN_WEI>

# Safe service defaults
KEEPER_DRY_RUN=true
KEEPER_RUN_ONCE=false
KEEPER_POLL_INTERVAL_MS=60000
KEEPER_CONFIRMATIONS=2
KEEPER_QUOTE_TIMEOUT_MS=10000
KEEPER_QUOTE_VALIDITY_BUFFER_SECONDS=30
KEEPER_RECEIPT_TIMEOUT_MS=180000
KEEPER_RPC_RETRY_ATTEMPTS=5
KEEPER_RPC_RETRY_BASE_DELAY_MS=1000
KEEPER_RPC_RETRY_MAX_DELAY_MS=30000
KEEPER_LOCK_STALE_MS=180000
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=240

# Manual recovery variables are supplied only to the non-restarting one-off job.
# Never persist these on the continuous automatic worker.
# KEEPER_MANUAL_ACK=AUTOMATION_STOPPED:4663:<CHECKSUMMED_BUYBACK_VAULT_ADDRESS>
# KEEPER_MANUAL_EXPECTED_NONCE=<LATEST_AND_PENDING_SIGNER_NONCE>
# KEEPER_MANUAL_REASON=<8_TO_200_CHARACTER_INCIDENT_NOTE>
