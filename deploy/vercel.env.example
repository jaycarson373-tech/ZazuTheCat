# ZAZU website, read-only on-chain API, and pons v1 quote route
# Replace every angle-bracket placeholder before importing into Vercel.

# Browser-visible values
NEXT_PUBLIC_SITE_URL=https://www.zazucatrh.fun
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_ZAZU_ADDRESS=<ZAZU_TOKEN_ADDRESS>
NEXT_PUBLIC_BUYBACK_VAULT_ADDRESS=<BUYBACK_VAULT_ADDRESS>
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Optional until the account is final
NEXT_PUBLIC_X_URL=https://x.com/<ZAZU_ACCOUNT>
NEXT_PUBLIC_PONS_URL=https://pons.family/launchpad
# Optional until the exact market URL is verified
NEXT_PUBLIC_DEX_URL=https://<VERIFIED_DEX_MARKET_URL>
# Optional until the verified ZAZU NFT mint page is live
NEXT_PUBLIC_NFT_MINT_URL=https://<VERIFIED_ZAZU_NFT_MINT_URL>

# Server-only values used by /api/stats and /api/buybacks
ROBINHOOD_RPC_URL=https://<ROBINHOOD_CHAIN_RPC_HOST>
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
ROBINHOOD_NATIVE_SYMBOL=ETH
CHAIN_ID=4663
ZAZU_TOKEN_ADDRESS=<ZAZU_TOKEN_ADDRESS>
BUYBACK_VAULT_ADDRESS=<BUYBACK_VAULT_ADDRESS>
BUYBACK_VAULT_START_BLOCK=<VAULT_DEPLOYMENT_BLOCK>
# Enables claim and flush receipts in /api/activity. CreatorFeesForwarded cannot
# occur before the vault exists, so the vault deployment block safely bounds it.
PONS_FEE_COLLECTOR_ADDRESS=<PREDEPLOYED_PONS_FEE_COLLECTOR_ADDRESS>
# Optional provider tuning. Defaults to 25000 and accepts 1 through 100000.
ACTIVITY_LOG_BLOCK_SPAN=25000
# Only events at or below head minus this depth enter the public receipt feed.
ACTIVITY_CONFIRMATION_DEPTH=2

# Server-only /api/quote configuration for pons v1 V3 only
PONS_QUOTER_V2_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
PONS_POOL_FEE=10000
WRAPPED_NATIVE_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
DEX_ROUTER_ADDRESS=<DEPLOYED_PONS_V3_ADAPTER_ADDRESS>
KEEPER_QUOTE_API_KEY=<SHARED_KEEPER_QUOTE_SECRET>
