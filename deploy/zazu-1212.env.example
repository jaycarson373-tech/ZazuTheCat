# Copy to a private file outside version control before deployment.
# The deployer needs Robinhood Chain ETH for gas. Never put this key in Vercel.
DEPLOYER_PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional. Uncomment only to use addresses other than the deployer wallet.
# NFT_OWNER=0x...
# NFT_PAYOUT_RECIPIENT=0x...

# Safe deployment defaults. The public sale starts closed.
NFT_UNREVEALED_URI=https://www.zazucatrh.fun/nft/hidden.json
NFT_BASE_URI=
NFT_CONTRACT_URI=https://www.zazucatrh.fun/nft/collection.json
NFT_START_SALE=false
