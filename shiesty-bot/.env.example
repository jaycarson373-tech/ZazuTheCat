# Bot identity. Use the numeric user ID and handle of the same automated account.
BOT_USERNAME=
BOT_USER_ID=
BOT_PROJECT=shiesty-pfp-bot

# Safe by default. Keep both values exactly as shown until X has approved AI replies.
BOT_DRY_RUN=true
X_AI_AUTOREPLY_APPROVED=false

# X reads. A bearer token is recommended for the mentions timeline.
X_BEARER_TOKEN=

# X OAuth 1.0a user-context credentials. Required in live mode for media + replies.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OpenAI. Not used in dry run. gpt-image-2 is the production default.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_BASE_URL=https://api.openai.com/v1

# Server-only Supabase credentials. Run supabase.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Conservative polling and anti-spam limits.
POLL_INTERVAL_MS=60000
MAX_PAGES_PER_POLL=5
MAX_REPLIES_PER_CYCLE=5
MAX_REPLIES_PER_HOUR=20
MAX_REPLIES_PER_AUTHOR_PER_DAY=2
MAX_MENTION_AGE_MINUTES=1440
MAX_PROFILE_IMAGE_BYTES=5000000
DOWNLOAD_TIMEOUT_MS=10000
OPENAI_TIMEOUT_MS=120000
