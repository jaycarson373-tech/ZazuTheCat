# Website and public registry
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_ZAZU_ADDRESS=
NEXT_PUBLIC_BUYBACK_VAULT_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_PONS_URL=https://pons.family/launchpad
NEXT_PUBLIC_DEX_URL=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Server-side chain reads and public APIs
ROBINHOOD_RPC_URL=
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
ROBINHOOD_NATIVE_SYMBOL=ETH
CHAIN_ID=4663
ZAZU_TOKEN_ADDRESS=
BUYBACK_VAULT_ADDRESS=
BUYBACK_VAULT_START_BLOCK=
ACTIVITY_LOG_BLOCK_SPAN=25000
ACTIVITY_CONFIRMATION_DEPTH=2

# Authenticated server-side pons v1 V3 quote route
PONS_QUOTER_V2_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
PONS_POOL_FEE=10000
WRAPPED_NATIVE_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
# Deployed PonsV3Adapter address, not the underlying pons swap router.
DEX_ROUTER_ADDRESS=
KEEPER_QUOTE_API_KEY=

# Foundry deployment. Never commit populated private keys.
DEPLOYER_PRIVATE_KEY=
# Zazu 1212 NFT deployment. Blank owner and payout values default to the deployer.
NFT_OWNER=
NFT_PAYOUT_RECIPIENT=
NFT_UNREVEALED_URI=https://www.zazucatrh.fun/nft/hidden.json
# Set this to the final immutable metadata folder, including the trailing slash.
NFT_BASE_URI=
NFT_CONTRACT_URI=https://www.zazucatrh.fun/nft/collection.json
# Keep false until every final image and metadata file has been pinned and checked.
NFT_START_SALE=false
KEEPER_ADDRESS=
# Must be the predeployed collector used as the pons creator fee wallet.
PONS_FEE_COLLECTOR_ADDRESS=
PONS_LOCKER_ADDRESS=0x736D76699C26D0d966744cAe304C000d471f7F35
PONS_SWAP_ROUTER_ADDRESS=0xCaf681a66D020601342297493863E78C959E5cb2
# The pons-launched ZAZU token already exists before adapter and vault deployment.
# Mainnet INITIAL_OWNER must be a deployed multisig contract, not the deployer.
INITIAL_OWNER=
# Must equal WRAPPED_NATIVE_ADDRESS for the pons WETH fee flow.
FEE_TOKEN_ADDRESS=
BUYBACK_DESTINATION=0x000000000000000000000000000000000000dEaD
MIN_EXECUTION_AMOUNT=
MAX_EXECUTION_AMOUNT=
# Positive value, hard-capped by the vault at 500 bps.
MAX_SLIPPAGE_BPS=
CONFIGURATION_DELAY_SECONDS=172800

# Railway keeper signer and fail-closed safety ceilings
KEEPER_PRIVATE_KEY=
KEEPER_QUOTE_API_URL=
KEEPER_MAX_PRICE_IMPACT_BPS=
KEEPER_MAX_GAS_UNITS=
KEEPER_MAX_GAS_COST_WEI=
KEEPER_DRY_RUN=true
KEEPER_RUN_ONCE=false
KEEPER_POLL_INTERVAL_MS=60000
KEEPER_CONFIRMATIONS=2
KEEPER_QUOTE_TIMEOUT_MS=10000
KEEPER_QUOTE_VALIDITY_BUFFER_SECONDS=30
KEEPER_RECEIPT_TIMEOUT_MS=180000
KEEPER_RPC_RETRY_ATTEMPTS=5
KEEPER_RPC_RETRY_BASE_DELAY_MS=1000
KEEPER_RPC_RETRY_MAX_DELAY_MS=30000
KEEPER_LOCK_STALE_MS=180000
KEEPER_LOCK_FILE=
KEEPER_LOG_FILE=
